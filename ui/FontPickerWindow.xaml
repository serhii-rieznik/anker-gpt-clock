<Window x:Class="AnkerClock.FontPickerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Choose clock font" Icon="clock.ico"
        Width="900" Height="710" MinWidth="780" MinHeight="560" WindowStartupLocation="CenterOwner"
        Background="#121620" Foreground="{StaticResource Text}" FontFamily="Segoe UI"
        SourceInitialized="InitializeWindow" Closed="ReleaseWindow">
  <Window.Resources>
    <Style TargetType="ListBoxItem">
      <Setter Property="Foreground" Value="{StaticResource Text}" />
      <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Margin" Value="5" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Surface" Background="#1B202C" BorderBrush="#353D4C" BorderThickness="2" CornerRadius="12" Padding="10">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource Accent}" /></Trigger>
              <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Surface" Property="Background" Value="#242C3C" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <DataTemplate x:Key="FontCard">
      <StackPanel>
        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" Margin="0,0,0,6" />
        <Grid Height="160">
          <TextBlock Text="{Binding Status}" Style="{StaticResource Hint}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <Image Source="{Binding Image}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
        </Grid>
        <CheckBox Content="Compare" IsChecked="{Binding Pinned, Mode=OneWay}" IsEnabled="{Binding CanPin}" Checked="PinFont" Unchecked="PinFont"
                  Margin="0,8,0,0" AutomationProperties.Name="{Binding Name, StringFormat=Compare {0}}" />
      </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="ComparisonCard">
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextAlignment="Center" Margin="0,0,0,16" />
        <Image Source="{Binding Image}" Width="320" Height="240" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
      </StackPanel>
    </DataTemplate>
  </Window.Resources>
  <Grid Margin="20">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <Grid Margin="5,0,5,16">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="Choose by appearance" FontSize="24" FontWeight="SemiBold" />
        <TextBlock Text="Pin two fonts to compare the same clock side by side." Style="{StaticResource Hint}" Margin="0,6,0,0" />
      </StackPanel>
      <Button x:Name="CompareButton" Grid.Column="1" Content="Compare (0/2)" IsEnabled="False" Click="ToggleComparison" Margin="12,0,0,0" VerticalAlignment="Center" AutomationProperties.AutomationId="CompareFonts" />
    </Grid>
    <Grid Grid.Row="1" Margin="5,0,5,10">
      <TextBox x:Name="SearchBox" TextChanged="FilterFonts" ToolTip="Search installed fonts"
               AutomationProperties.AutomationId="FontSearch" AutomationProperties.Name="Search installed fonts" />
      <TextBlock Text="Search fonts…" Foreground="{StaticResource Muted}" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding ElementName=SearchBox, Path=Text.Length}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
      </TextBlock>
    </Grid>
    <ListBox x:Name="Gallery" Grid.Row="2" Background="Transparent" BorderThickness="0" SelectedValuePath="Name"
             ItemTemplate="{StaticResource FontCard}" SelectionChanged="SelectFont" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             AutomationProperties.AutomationId="FontGallery" AutomationProperties.Name="Clock font previews">
      <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate></ListBox.ItemsPanel>
    </ListBox>
    <ListBox x:Name="Comparison" Grid.Row="2" Background="Transparent" BorderThickness="0" SelectedValuePath="Name" Visibility="Collapsed"
             ItemTemplate="{StaticResource ComparisonCard}" SelectionChanged="SelectFont" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             AutomationProperties.AutomationId="FontComparison" AutomationProperties.Name="Side by side clock previews">
      <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ListBox.ItemsPanel>
    </ListBox>
    <TextBlock x:Name="EmptyMessage" Grid.Row="2" Text="No fonts match your search." Style="{StaticResource Hint}" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" />
    <Grid Grid.Row="3" Margin="5,14,5,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="12" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <Button x:Name="PreviousButton" Content="Previous" Click="PreviousPage" Padding="12,8" AutomationProperties.AutomationId="PreviousFonts" />
      <Button x:Name="NextButton" Grid.Column="1" Content="Next" Click="NextPage" Padding="12,8" Margin="8,0,0,0" AutomationProperties.AutomationId="NextFonts" />
      <TextBlock x:Name="PageStatus" Grid.Column="2" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="12,0,12,0" AutomationProperties.AutomationId="FontPageStatus" />
      <Button Grid.Column="3" Content="Cancel" IsCancel="True" AutomationProperties.AutomationId="CancelFont" />
      <Button x:Name="UseButton" Grid.Column="5" Content="Use font" Style="{StaticResource Primary}" IsEnabled="False" Click="UseFont" AutomationProperties.AutomationId="UseFont" />
    </Grid>
  </Grid>
</Window>
