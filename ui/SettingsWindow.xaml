<Window x:Class="AnkerClock.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Anker Clock" Width="960" Height="680" MinWidth="900" MinHeight="500" WindowStartupLocation="CenterScreen"
        Background="#121620" Foreground="{StaticResource Text}" FontFamily="Segoe UI" FontSize="13"
        Icon="clock.ico" SourceInitialized="InitializeWindow" Closing="ConfirmClose" Closed="ReleaseWindow" KeyDown="KeyPressed">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="56" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" />
  </shell:WindowChrome.WindowChrome>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="64" /><RowDefinition Height="*" /><RowDefinition Height="76" /></Grid.RowDefinitions>
    <Grid Margin="28,0,14,0">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Border Width="32" Height="32" CornerRadius="10" Background="#2E3A55" Margin="0,0,12,0">
          <Image Source="{StaticResource ClockMark}" Width="24" Height="24" />
        </Border>
        <TextBlock Text="Anker Clock" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
        <Button Content="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="11" Padding="14,12" Background="Transparent" BorderThickness="0" ToolTip="Minimize" Click="Minimize" AutomationProperties.AutomationId="Minimize" AutomationProperties.Name="Minimize settings" />
        <Button Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="11" Padding="14,12" Background="Transparent" BorderThickness="0" ToolTip="Close settings" Click="CloseSettings" AutomationProperties.AutomationId="Close" AutomationProperties.Name="Close settings" />
      </StackPanel>
    </Grid>
    <Grid Grid.Row="1" Margin="28,8,28,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="352" /><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
        <TextBlock Text="Live preview" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,6" />
        <TextBlock x:Name="FaceSummary" Style="{StaticResource Hint}" Margin="0,0,0,14" />
        <Border Background="#07090F" BorderBrush="#30394C" BorderThickness="1" CornerRadius="16" Padding="10">
          <Grid>
            <Image x:Name="ClockPreview" Width="320" Height="240" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.AutomationId="ClockPreview" AutomationProperties.Name="Clock preview at display resolution" />
          </Grid>
        </Border>
        <Button x:Name="WeatherWarning" Visibility="Collapsed" Click="ShowWeatherDetails" Background="Transparent" BorderThickness="0" Padding="0,12,0,0" HorizontalContentAlignment="Left" AutomationProperties.AutomationId="WeatherWarning">
          <TextBlock x:Name="WeatherWarningText" Text="Weather unavailable · view details" Foreground="#D5B889" TextWrapping="Wrap" />
        </Button>
        <Grid Margin="0,18,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <Ellipse x:Name="ConnectionDot" Width="6" Height="6" Fill="#8492AE" VerticalAlignment="Top" Margin="0,5,0,0" />
          <StackPanel Grid.Column="1">
            <TextBlock x:Name="ConnectionStatus" FontSize="12" TextWrapping="Wrap" AutomationProperties.AutomationId="Status" />
            <TextBlock x:Name="TimingStatus" Style="{StaticResource Hint}" Margin="0,5,0,0" />
          </StackPanel>
        </Grid>
        <Grid Margin="0,20,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <Button x:Name="UpdateButton" Content="Update now" Style="{StaticResource Primary}" Click="UpdateNow" AutomationProperties.AutomationId="UpdateNow" />
          <Button x:Name="PauseButton" Grid.Column="2" Content="Pause" Click="TogglePause" MinWidth="92" AutomationProperties.AutomationId="Pause" />
        </Grid>
      </StackPanel>
      </ScrollViewer>
      <Grid Grid.Column="2">
        <Grid.RowDefinitions><RowDefinition Height="46" /><RowDefinition Height="18" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Border Background="#1B202C" CornerRadius="10" Padding="4">
          <UniformGrid Columns="5">
            <RadioButton x:Name="AppearanceTab" Content="Appearance" GroupName="Navigation" IsChecked="True" Tag="0" Checked="Navigate" Padding="8,8" AutomationProperties.AutomationId="AppearanceTab" />
            <RadioButton x:Name="ClockTab" Content="Clock" GroupName="Navigation" Tag="1" Checked="Navigate" Padding="8,8" AutomationProperties.AutomationId="ClockTab" />
            <RadioButton x:Name="DeviceTab" Content="Device" GroupName="Navigation" Tag="2" Checked="Navigate" Padding="8,8" AutomationProperties.AutomationId="DeviceTab" />
            <RadioButton x:Name="StartupTab" Content="Startup" GroupName="Navigation" Tag="3" Checked="Navigate" Padding="8,8" AutomationProperties.AutomationId="StartupTab" />
            <RadioButton x:Name="NetatmoTab" Content="Netatmo" GroupName="Navigation" Tag="4" Checked="Navigate" Padding="8,8" AutomationProperties.AutomationId="NetatmoTab" />
          </UniformGrid>
        </Border>
        <Border Grid.Row="2" Background="#1B202C" CornerRadius="14" Padding="22,22,16,16">
          <Grid>
            <ScrollViewer x:Name="AppearancePanel" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Margin="0,0,6,0">
                <TextBlock Text="Background" Style="{StaticResource Section}" />
                <ComboBox x:Name="ThemeChoice" AutomationProperties.AutomationId="Theme" AutomationProperties.Name="Background preset" />
                <StackPanel x:Name="ImageOptions" Margin="0,12,0,0" Visibility="Collapsed">
                  <Button Content="Choose image…" Click="ChooseImage" AutomationProperties.AutomationId="ChooseImage" />
                  <TextBlock x:Name="ImagePath" Style="{StaticResource Hint}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,8,0,12" />
                  <ComboBox x:Name="FitChoice" AutomationProperties.AutomationId="BackgroundFit" AutomationProperties.Name="Background image sizing" />
                  <TextBlock Text="Image dimming" Style="{StaticResource Label}" Margin="0,16,0,4" />
                  <Slider x:Name="DimSlider" Minimum="0" Maximum="85" AutomationProperties.AutomationId="ImageDim" AutomationProperties.Name="Background dimming percent" />
                </StackPanel>
                <StackPanel x:Name="DitherOptions">
                <TextBlock Text="{Binding ElementName=DitherSlider, Path=Value, StringFormat=Gradient smoothing · {0:0}}" Style="{StaticResource Label}" Margin="0,16,0,4" />
                <Slider x:Name="DitherSlider" Minimum="0" Maximum="8" TickFrequency="1" IsSnapToTickEnabled="True" AutomationProperties.AutomationId="BackgroundDither" AutomationProperties.Name="Background gradient smoothing strength" />
                <TextBlock Text="Fine dithering softens banding. 0 turns it off." Style="{StaticResource Hint}" Margin="0,8,0,0" />
                </StackPanel>
                <StackPanel x:Name="TypographyOptions">
                <Border Height="1" Background="#303746" Margin="0,24,0,22" />
                <TextBlock Text="Typography" Style="{StaticResource Section}" />
                <TextBlock Text="Font family" Style="{StaticResource Label}" />
                <Button x:Name="FontChoice" Click="ChooseFont" HorizontalContentAlignment="Left" AutomationProperties.AutomationId="Font" AutomationProperties.Name="Browse clock fonts" AutomationProperties.HelpText="{Binding RelativeSource={RelativeSource Self}, Path=Content}" />
                <TextBlock Text="Browse clock previews and compare two fonts." Style="{StaticResource Hint}" Margin="0,8,0,0" />
                <Grid Margin="0,16,0,0">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <StackPanel x:Name="FontStyleOptions">
                    <TextBlock Text="Weight &amp; style" Style="{StaticResource Label}" />
                    <ComboBox x:Name="StyleChoice" DisplayMemberPath="Name" SelectedValuePath="Key" AutomationProperties.AutomationId="FontStyle" AutomationProperties.Name="Font style" />
                  </StackPanel>
                  <Grid Grid.Column="2">
                    <StackPanel x:Name="DigitalSizeOptions">
                      <TextBlock Text="{Binding ElementName=SizeSlider, Path=Value, StringFormat=Size · {0:0} px}" Style="{StaticResource Label}" />
                      <Slider x:Name="SizeSlider" Minimum="36" Maximum="110" Margin="0,6,0,0" AutomationProperties.AutomationId="FontSize" AutomationProperties.Name="Font size in pixels" />
                    </StackPanel>
                    <StackPanel x:Name="AnalogSizeOptions">
                      <TextBlock Style="{StaticResource Label}"><Run x:Name="AnalogSizeName" Text="Numerals" /><Run Text="{Binding ElementName=AnalogSizeSlider, Path=Value, StringFormat= · {0:0}}" /><Run x:Name="AnalogSizeUnit" Text=" px" /></TextBlock>
                      <Slider x:Name="AnalogSizeSlider" Minimum="12" Maximum="32" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,6,0,0" AutomationProperties.AutomationId="AnalogFontSize" AutomationProperties.Name="Analog numeral size in pixels" />
                    </StackPanel>
                  </Grid>
                </Grid>
                <TextBlock x:Name="AnalogTypographyHint" Text="Numeral spacing adapts to your font and size." Style="{StaticResource Hint}" Margin="0,10,0,0" />
                </StackPanel>
                <Border Height="1" Background="#303746" Margin="0,24,0,22" />
                <TextBlock Text="Colors" Style="{StaticResource Section}" />
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="Clock color" Style="{StaticResource Label}" />
                    <TextBox x:Name="TextColorBox" MaxLength="7" AutomationProperties.AutomationId="TextColor" AutomationProperties.Name="Clock color in hexadecimal" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                      <Button Background="#F5F8FF" Tag="text:F5F8FF" Click="ChoosePalette" Padding="0" Width="24" Height="24" BorderThickness="0" Margin="0,0,8,0" ToolTip="Ice white" AutomationProperties.Name="Ice white clock color" />
                      <Button Background="#E8D9B7" Tag="text:E8D9B7" Click="ChoosePalette" Padding="0" Width="24" Height="24" BorderThickness="0" Margin="0,0,8,0" ToolTip="Ivory" AutomationProperties.Name="Ivory clock color" />
                      <Button Background="#ABBDDD" Tag="text:ABBDDD" Click="ChoosePalette" Padding="0" Width="24" Height="24" BorderThickness="0" ToolTip="Slate blue" AutomationProperties.Name="Slate blue clock color" />
                    </StackPanel>
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="Accent color" Style="{StaticResource Label}" />
                    <TextBox x:Name="AccentColorBox" MaxLength="7" AutomationProperties.AutomationId="AccentColor" AutomationProperties.Name="Accent color in hexadecimal" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                      <Button Background="#90B8FF" Tag="accent:90B8FF" Click="ChoosePalette" Padding="0" Width="24" Height="24" BorderThickness="0" Margin="0,0,8,0" ToolTip="Sky blue" AutomationProperties.Name="Sky blue accent color" />
                      <Button Background="#B7A3F4" Tag="accent:B7A3F4" Click="ChoosePalette" Padding="0" Width="24" Height="24" BorderThickness="0" Margin="0,0,8,0" ToolTip="Lavender" AutomationProperties.Name="Lavender accent color" />
                      <Button Background="#F2B881" Tag="accent:F2B881" Click="ChoosePalette" Padding="0" Width="24" Height="24" BorderThickness="0" ToolTip="Apricot" AutomationProperties.Name="Apricot accent color" />
                    </StackPanel>
                  </StackPanel>
                </Grid>
              </StackPanel>
            </ScrollViewer>
            <ScrollViewer x:Name="ClockPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Margin="0,0,6,0">
                <TextBlock Text="Clock face" Style="{StaticResource Section}" />
                <Border Background="#242A36" CornerRadius="9" Padding="3" Margin="0,0,0,20">
                  <UniformGrid Columns="3">
                    <RadioButton x:Name="SignatureFace" Content="Signature" GroupName="Face" Tag="0" AutomationProperties.AutomationId="Signature" />
                    <RadioButton x:Name="DigitalFace" Content="Digital" GroupName="Face" Tag="1" AutomationProperties.AutomationId="Digital" />
                    <RadioButton x:Name="AnalogFace" Content="Analog" GroupName="Face" Tag="2" AutomationProperties.AutomationId="Analog" />
                  </UniformGrid>
                </Border>
                <StackPanel x:Name="AnalogFaceOptions" Margin="0,0,0,16">
                  <TextBlock Text="Analog style" Style="{StaticResource Label}" />
                  <ComboBox x:Name="AnalogFaceChoice" AutomationProperties.AutomationId="AnalogFace" AutomationProperties.Name="Analog clock style" />
                </StackPanel>
                <TextBlock Text="Time zone" Style="{StaticResource Label}" />
                <ComboBox x:Name="ZoneChoice" DisplayMemberPath="Name" SelectedValuePath="Key" AutomationProperties.AutomationId="TimeZone" AutomationProperties.Name="Time zone" />
                <StackPanel x:Name="DateFormatOptions">
                <TextBlock Text="Date format" Style="{StaticResource Label}" Margin="0,16,0,8" />
                <ComboBox x:Name="DateChoice" AutomationProperties.AutomationId="DateFormat" AutomationProperties.Name="Date format" />
                </StackPanel>
                <StackPanel x:Name="HeadingOptions">
                <TextBlock Text="Custom heading" Style="{StaticResource Label}" Margin="0,16,0,8" />
                <TextBox x:Name="LabelBox" MaxLength="40" AutomationProperties.AutomationId="Label" AutomationProperties.Name="Custom heading" />
                <TextBlock Text="Custom text replaces the weekday." Style="{StaticResource Hint}" Margin="0,6,0,14" />
                <CheckBox x:Name="WeekdaySwitch" Content="Show weekday" AutomationProperties.AutomationId="ShowWeekday" />
                </StackPanel>
                <CheckBox x:Name="HourSwitch" Content="24-hour time" AutomationProperties.AutomationId="Use24Hour" />
                <CheckBox x:Name="SecondsSwitch" Content="Show seconds / second hand" AutomationProperties.AutomationId="ShowSeconds" />
                <CheckBox x:Name="DateSwitch" Content="Show date" AutomationProperties.AutomationId="ShowDate" />
                <Border Height="1" Background="#303746" Margin="0,6,0,20" />
                <CheckBox x:Name="CodexSwitch" Content="Show Codex usage" AutomationProperties.AutomationId="ShowCodexUsage" />
                <TextBlock x:Name="CodexHint" Style="{StaticResource Hint}" Margin="0,-6,0,14" />
                <StackPanel x:Name="CodexOptions">
                <TextBlock Text="Usage refresh" Style="{StaticResource Label}" />
                <Grid Margin="0,0,0,12">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <TextBox x:Name="CodexIntervalBox" MaxLength="5" AutomationProperties.AutomationId="CodexRefreshSeconds" AutomationProperties.Name="Codex usage refresh interval in seconds" />
                  <TextBlock Grid.Column="1" Text="seconds" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0,0,0" />
                </Grid>
                <TextBlock Text="Uses your local Codex sign-in. Queries start 2.5 seconds before each refresh boundary; unavailable usage stays hidden." Style="{StaticResource Hint}" Margin="0,0,0,20" />
                </StackPanel>
                <StackPanel x:Name="OffsetOptions">
                <TextBlock Text="Vertical position" Style="{StaticResource Label}" />
                <Slider x:Name="OffsetSlider" Minimum="-20" Maximum="20" AutomationProperties.AutomationId="VerticalOffset" AutomationProperties.Name="Vertical position" />
                </StackPanel>
              </StackPanel>
            </ScrollViewer>
            <ScrollViewer x:Name="DevicePanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Margin="0,0,6,0">
                <TextBlock Text="Update cadence" Style="{StaticResource Section}" />
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <TextBox x:Name="IntervalBox" MaxLength="5" AutomationProperties.AutomationId="Interval" AutomationProperties.Name="Update interval in seconds" />
                  <TextBlock Grid.Column="1" Text="seconds" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0,0,0" />
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,16">
                  <Button Content="5 s" Tag="5" Click="ChooseInterval" Padding="12,6" Margin="0,0,8,0" />
                  <Button Content="10 s" Tag="10" Click="ChooseInterval" Padding="12,6" Margin="0,0,8,0" AutomationProperties.AutomationId="Interval10" />
                  <Button Content="30 s" Tag="30" Click="ChooseInterval" Padding="12,6" Margin="0,0,8,0" />
                  <Button Content="60 s" Tag="60" Click="ChooseInterval" Padding="12,6" />
                </StackPanel>
                <TextBlock Text="Updates align to the clock. At 10 seconds, the screen changes at :00, :10, :20…" Style="{StaticResource Hint}" />
                <TextBlock Text="Images are sent 0.5 seconds early to allow for the screen transition." Style="{StaticResource Hint}" Margin="0,8,0,0" />
                <Border Height="1" Background="#303746" Margin="0,24,0,22" />
                <TextBlock Text="{Binding ElementName=BrightnessSlider, Path=Value, StringFormat=Screen brightness · {0:0}%}" Style="{StaticResource Section}" />
                <Slider x:Name="BrightnessSlider" Minimum="10" Maximum="100" AutomationProperties.AutomationId="Brightness" AutomationProperties.Name="Screen brightness percent" />
                <Border Height="1" Background="#303746" Margin="0,24,0,22" />
                <TextBlock Text="The hub gallery is used only for this clock. Old images are removed; no image backups are saved." Style="{StaticResource Hint}" AutomationProperties.AutomationId="GalleryPolicy" />
              </StackPanel>
            </ScrollViewer>
            <ScrollViewer x:Name="StartupPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Margin="0,0,6,0">
                <TextBlock Text="Ready when you are" Style="{StaticResource Section}" />
                <CheckBox x:Name="StartupSwitch" Content="Start with Windows" AutomationProperties.AutomationId="StartWithWindows" />
                <TextBlock Text="Starts quietly in the system tray." Style="{StaticResource Hint}" Margin="0,-10,0,24" />
                <CheckBox x:Name="LaunchSwitch" Content="Open settings on manual launch" AutomationProperties.AutomationId="OpenSettings" />
                <Border Height="1" Background="#303746" Margin="0,6,0,22" />
                <TextBlock Text="Pause automatically" Style="{StaticResource Section}" />
                <CheckBox x:Name="BatterySwitch" Content="While running on battery" AutomationProperties.AutomationId="PauseOnBattery" />
                <TextBlock Text="While Windows is locked, the clock keeps running with a lock badge and elapsed duration." Style="{StaticResource Hint}" Margin="0,8,0,0" />
              </StackPanel>
            </ScrollViewer>
            <ScrollViewer x:Name="NetatmoPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Margin="0,0,6,0">
                <TextBlock Text="Your weather station" Style="{StaticResource Section}" />
                <Border Background="#202735" BorderBrush="#30394C" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,16">
                  <StackPanel>
                    <TextBlock x:Name="NetatmoDisplayStatus" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.AutomationId="NetatmoDisplayStatus" />
                    <TextBlock x:Name="NetatmoAction" Style="{StaticResource Hint}" Margin="0,8,0,0" AutomationProperties.AutomationId="NetatmoAction" />
                    <TextBlock x:Name="NetatmoAge" Style="{StaticResource Hint}" Margin="0,10,0,0" AutomationProperties.AutomationId="NetatmoAge" />
                    <TextBlock x:Name="NetatmoPolling" Style="{StaticResource Hint}" Margin="0,6,0,0" AutomationProperties.AutomationId="NetatmoPolling" />
                    <TextBlock x:Name="NetatmoStatus" Style="{StaticResource Hint}" Margin="0,6,0,0" AutomationProperties.AutomationId="NetatmoStatus" />
                  </StackPanel>
                </Border>
                <Button x:Name="RefreshNetatmoButton" Content="Refresh readings now" Click="RefreshNetatmo" AutomationProperties.AutomationId="RefreshNetatmo" Margin="0,0,0,16" />
                <Button Content="Import Netatmo credentials…" Click="ImportNetatmo" AutomationProperties.AutomationId="ImportNetatmo" />
                <TextBlock Text="Choose a TXT or JSON file containing your Netatmo client ID, client secret, access token and refresh token. Windows protects the saved credentials." Style="{StaticResource Hint}" Margin="0,10,0,16" />
                <StackPanel x:Name="NetatmoStyleHint" Visibility="Collapsed">
                  <TextBlock Text="Station readings are shown on the Analog face." Style="{StaticResource Hint}" Margin="0,0,0,10" />
                  <Button Content="Switch to Analog" Click="UseAnalog" AutomationProperties.AutomationId="UseAnalog" />
                </StackPanel>
                <CheckBox x:Name="NetatmoSwitch" Content="Show readings beside the analog clock" AutomationProperties.AutomationId="ShowNetatmo" />
                <StackPanel x:Name="NetatmoOptions">
                <TextBlock Text="{Binding ElementName=ReadingSizeSlider, Path=Value, StringFormat=Value size · {0:0} px}" Style="{StaticResource Label}" Margin="0,6,0,8" />
                <Slider x:Name="ReadingSizeSlider" Minimum="28" Maximum="38" TickFrequency="1" IsSnapToTickEnabled="True" AutomationProperties.AutomationId="ReadingFontSize" AutomationProperties.Name="Reading value size in pixels" Margin="0,0,0,16" />
                <TextBlock Text="Module to display" Style="{StaticResource Label}" />
                <ComboBox x:Name="NetatmoChoice" DisplayMemberPath="Name" SelectedValuePath="Key" AutomationProperties.AutomationId="NetatmoModule" AutomationProperties.Name="Netatmo module to display" Margin="0,0,0,16" />
                <TextBlock Text="Displayed readings" Style="{StaticResource Label}" />
                <CheckBox x:Name="TemperatureSwitch" Content="Temperature" AutomationProperties.AutomationId="NetatmoTemperature" />
                <CheckBox x:Name="HumiditySwitch" Content="Humidity" AutomationProperties.AutomationId="NetatmoHumidity" />
                <CheckBox x:Name="Co2Switch" Content="CO₂" AutomationProperties.AutomationId="NetatmoCo2" />
                <CheckBox x:Name="NoiseSwitch" Content="Noise level" AutomationProperties.AutomationId="NetatmoNoise" />
                <TextBlock x:Name="ReadingsHint" Style="{StaticResource Hint}" Margin="0,-6,0,18" />
                <TextBlock Text="Reading refresh" Style="{StaticResource Label}" />
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <TextBox x:Name="NetatmoIntervalBox" MaxLength="5" AutomationProperties.AutomationId="NetatmoRefreshSeconds" AutomationProperties.Name="Netatmo refresh interval in seconds" />
                  <TextBlock Grid.Column="1" Text="seconds" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0,0,0" />
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,12">
                  <Button Content="1 minute" Tag="60" Click="ChooseNetatmoInterval" Margin="0,0,8,0" />
                  <Button Content="5 minutes" Tag="300" Click="ChooseNetatmoInterval" />
                </StackPanel>
                <TextBlock Text="The clock and readings refresh separately. Netatmo measures about every five minutes; cloud readings can arrive later." Style="{StaticResource Hint}" />
                </StackPanel>
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </Border>
      </Grid>
    </Grid>
    <Grid Grid.Row="2" Margin="28,14,28,16">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="12" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <TextBlock x:Name="ValidationMessage" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,14,0" AutomationProperties.AutomationId="Validation" />
      <Button x:Name="ReviewButton" Grid.Column="1" Content="Review" Visibility="Collapsed" Margin="0,0,12,0" Click="ReviewError" AutomationProperties.AutomationId="ReviewError" />
      <Button x:Name="HideButton" Grid.Column="2" Content="Hide to tray" Click="CloseSettings" AutomationProperties.AutomationId="Hide" />
      <Button x:Name="SaveButton" Grid.Column="4" Content="Save changes" Style="{StaticResource Primary}" Click="SaveChanges" AutomationProperties.AutomationId="Save" />
    </Grid>
  </Grid>
</Window>
